<Window x:Class="WpfMyGallery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfMyGallery"
        mc:Ignorable="d"
        Title="Галерея зображень" Height="600" Width="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <WrapPanel Margin="10">
            <Button Content="Оберіть папку..." Padding="15,5" Click="SelectFolder_Click"/>
            <TextBlock x:Name="PathText" Margin="15,0,0,0" VerticalAlignment="Center"/>
        </WrapPanel>
        <ListBox Name="GalleryList" Grid.Row="1" Margin="10"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Image Source="{Binding}" Width="150" Height="150"
                           Stretch="UniformToFill" Margin="5"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
            
        </ListBox>
    </Grid>
</Window>
