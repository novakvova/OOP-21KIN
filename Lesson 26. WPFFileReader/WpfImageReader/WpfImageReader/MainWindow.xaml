<Window x:Class="WpfImageReader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfImageReader"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <WrapPanel Margin="10">
            <Button x:Name="btnDownload" 
                    Padding="12,6"
                    Content="Завантажити фото" Click="btnDownload_Click"/>
            <TextBox Padding="12,6" 
                     MinWidth="400" 
                     Margin ="20,0,0,0" 
                     x:Name="txtUrl"  />
            <Button x:Name="btnReadImages" 
                    Margin="20,0"
                    Padding="12,6"
                    Content="Читання з папки"/>
        </WrapPanel>
    </Grid>
</Window>
