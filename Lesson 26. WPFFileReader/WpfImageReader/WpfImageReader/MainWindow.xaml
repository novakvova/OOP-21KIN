<Window x:Class="WpfImageReader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfImageReader"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <WrapPanel Margin="10">
            <Button x:Name="btnDownload" 
                    Padding="12,6"
                    Content="Завантажити фото" Click="btnDownload_Click"/>
            <TextBox Padding="12,6" 
                     MinWidth="400" 
                     Margin ="20,0,0,0" 
                     x:Name="txtUrl"  />
            <!--Читання вміступ папки - відбраження зображень, ім'я, розмір і дата створення-->
            <Button x:Name="btnReadImages" 
                    Click="btnReadImages_Click"
                    Margin="20,0"
                    Padding="12,6"
                    Content="Читання з папки"/>
        </WrapPanel>

        <ListBox Name="GalleryList" Grid.Row="1" Margin="10"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!--<Image Source="{Binding}" Width="150" Height="150"
                           Stretch="UniformToFill" Margin="5"/>-->
                    <StackPanel>
                        <Image Source="{Binding Image}"
                               MaxHeight="150"
                               Stretch="Uniform"/>
                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding FileSize, StringFormat={}{0} Кб}"/>
                        <TextBlock Text="{Binding DateCreated, StringFormat=dd.MM.yyyy HH:mm}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>

    </Grid>
</Window>
