<Window x:Class="WpfTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfTest"
        mc:Ignorable="d"
        Title="Тест" Height="400" Width="600" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="16">
        <ProgressBar x:Name="ProgressBar" Height="18" Minimum="0" />
        <TextBlock x:Name="ProgressText" Margin="0,8,0,0" FontWeight="Bold" />
        <TextBlock x:Name="QuestionText" Margin="0,12" FontSize="18" TextWrapping="Wrap" />
        <StackPanel x:Name="AnswersPanel" Margin="0,8" />
        <Button x:Name="NextButton" Content="Далі" Width="120" Margin="0,16,0,0"
                HorizontalAlignment="Right" Click="NextButton_Click" />
    </StackPanel>
</Window>
