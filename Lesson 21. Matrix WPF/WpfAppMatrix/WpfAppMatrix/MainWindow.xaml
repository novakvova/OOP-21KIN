<Window x:Class="WpfAppMatrix.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppMatrix"
        mc:Ignorable="d"
        Title="Калькулятор матриць" 
        Height="680" Width="1150"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="10">
        <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Margin="0,8,0,0" 
                   FontSize="14" Text="Готово. Міняємо розмір матриці та очислюємо"/>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Матриця А -->
            <GroupBox Grid.Row="0" Grid.Column="0" Header="Матриця A" 
                      Margin="5" Padding="5">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="Рядків:" VerticalAlignment="Center"/>
                        <TextBox x:Name="RowsA" Text="3" Width="35" Margin="4,0" 
                                 TextAlignment="Center"/>
                        <TextBlock Text="Стовпців:" VerticalAlignment="Center"/>
                        <TextBox x:Name="ColsA" Text="3" Width="35" Margin="4,0"
                                 TextAlignment="Center"/>
                        <Button Content="Застосувати" Tag="A"/>
                        <Button Content="Випадково" Tag="A"/>
                        <Button Content="Одинична" Tag="A"/>
                        <Button Content="Очистити" Tag="A"/>
                    </WrapPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                                  VerticalScrollBarVisibility="Auto">
                        <UniformGrid x:Name="GridA" 
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top"/>
                    </ScrollViewer>
                </DockPanel>
            </GroupBox>

            <!-- Матриця B -->
            <GroupBox Grid.Row="0" Grid.Column="2" Header="Матриця B" 
                      Margin="5" Padding="6">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="Рядків:" VerticalAlignment="Center"/>
                        <TextBox x:Name="RowsB" Text="3" Width="35" Margin="4,0" 
                                 TextAlignment="Center"/>
                        <TextBlock Text="Стовпців:" VerticalAlignment="Center"/>
                        <TextBox x:Name="ColsB" Text="3" Width="35" Margin="4,0"
                                 TextAlignment="Center"/>
                        <Button Content="Застосувати" Tag="B"/>
                        <Button Content="Випадково" Tag="B"/>
                        <Button Content="Одинична" Tag="B"/>
                        <Button Content="Очистити" Tag="B"/>
                    </WrapPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <UniformGrid x:Name="GridB" 
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top"/>
                    </ScrollViewer>
                </DockPanel>
            </GroupBox>

            <!-- Операції -->
            <GroupBox Grid.Row="0" Grid.Column="1" Header="Операції" 
                      Margin="5" Padding="6">
                <StackPanel Width="140">
                    <Button Content="A+B" Click="Button_Add_Click"/>
                </StackPanel>
            </GroupBox>

            <!-- Матриця С -->
            <GroupBox Grid.Row="1" Grid.Column="0" Header="Результат С" 
                      Margin="5" Padding="6">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                    <UniformGrid x:Name="GridC" 
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top"/>
                </ScrollViewer>
            </GroupBox>
        </Grid>

    </DockPanel>
</Window>
